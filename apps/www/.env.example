# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DX
NEXT_PUBLIC_APP_VERSION=0.0.0-dev

# ── Better Auth ──
BETTER_AUTH_SECRET=           # Random secret for session signing (min 32 chars)
BETTER_AUTH_WEBHOOK_SECRET=   # Webhook signature verification secret

# ── GitHub OAuth (optional) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Google OAuth (optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/dx

# ── Chat ──
NEXT_PUBLIC_SOCKET_URL=
SOCKET_SECRET=

# ── Analytics ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Search ──
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
ALGOLIA_ADMIN_KEY=
